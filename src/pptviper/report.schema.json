    "config": {
      "type": "object",
      "properties": {
        "max_expanded_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_parts": {
          "type": "integer",
          "minimum": 1
        },
        "off_slide_threshold_emu": {
          "type": "integer",
          "minimum": 0
        },
        "suppress": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "enum": [
                  "off-slide",
                  "invalid-ooxml",
                  "unreadable-part",
                  "edge-margin",
                  "overlap",
                  "too-close",
                  "misaligned",
                  "uneven-gap",
                  "uneven-size",
                  "zero-size",
                  "tiny-shape",
                  "hidden-shape",
                  "connector-unattached",
                  "position-drift",
                  "layout-override",
                  "autofit-shrunk",
                  "font-too-small",
                  "font-size-inconsistent",
                  "line-spacing-inconsistent",
                  "font-family-count",
                  "east-asian-font-unset",
                  "empty-paragraph-spacing",
                  "manual-line-break",
                  "bullet-inconsistent",
                  "title-missing",
                  "title-duplicate",
                  "empty-placeholder",
                  "text-hygiene",
                  "table-column-uneven",
                  "text-overflow",
                  "unbreakable-word",
                  "excessive-wrap",
                  "orphan-line",
                  "font-missing",
                  "table-cell-overflow",
                  "table-overflow",
                  "low-contrast",
                  "low-contrast-non-text",
                  "off-theme-color",
                  "near-duplicate-color",
                  "color-count",
                  "image-distorted",
                  "image-low-resolution",
                  "image-crop-outside"
                ]
              },
              "slide": {
                "type": "string"
              },
              "shape": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edge-margin",
            "too-close",
            "misaligned",
            "tiny-shape",
            "font-too-small",
            "font-too-small-note",
            "font-family-count"
          ],
          "properties": {
            "edge-margin": {
              "type": "number",
              "minimum": 0
            },
            "too-close": {
              "type": "number",
              "minimum": 0
            },
            "misaligned": {
              "type": "number",
              "minimum": 0
            },
            "tiny-shape": {
              "type": "number",
              "minimum": 0
            },
            "font-too-small": {
              "type": "number",
              "minimum": 0
            },
            "font-too-small-note": {
              "type": "number",
              "minimum": 0
            },
            "font-family-count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "measure_text": {
          "type": "boolean"
        },
        "system_fonts": {
          "type": "boolean"
        },
        "font_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contrast_level": {
          "enum": [
            "AA",
            "AAA"
          ]
        }
      },
      "required": [
        "max_expanded_bytes",
        "max_parts",
        "off_slide_threshold_emu",
        "suppress",
        "thresholds",
        "measure_text",
        "system_fonts",
        "font_paths",
        "contrast_level"
      ],
      "additionalProperties": false
    },
    "shape_record": {
      "type": "object",
      "properties": {
        "slide": {
          "$ref": "#/$defs/slide"
        },
        "shapes": {
          "type": "array",
