            "layout-override",
            "autofit-shrunk",
            "font-too-small",
            "font-size-inconsistent",
            "line-spacing-inconsistent",
            "font-family-count",
            "east-asian-font-unset",
            "empty-paragraph-spacing",
            "manual-line-break",
            "bullet-inconsistent",
            "title-missing",
            "title-duplicate",
            "empty-placeholder",
            "text-hygiene",
            "table-column-uneven",
            "text-overflow",
            "unbreakable-word",
            "excessive-wrap",
            "orphan-line",
            "font-missing",
            "table-cell-overflow",
            "table-overflow",
            "low-contrast",
            "low-contrast-non-text",
            "off-theme-color",
            "near-duplicate-color",
            "color-count",
            "image-distorted",
            "image-low-resolution",
            "image-crop-outside"
          ]
        },
        "locator": {
          "type": "string"
        },
        "slide": {
          "anyOf": [
            {
              "$ref": "#/$defs/slide"
            },
            {
              "type": "null"
            }
          ]
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "locator",
        "slide",
        "shapes",
        "reason"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "finding": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "not-applicable": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "candidates",
        "pass",
        "finding",
        "unknown",
        "not-applicable"
      ],
      "additionalProperties": false
