{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellar-aiz.github.io/pptviper/report.schema.json",
  "title": "pptviper inspection report",
  "type": "object",
  "$defs": {
    "slide": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "number",
        "id"
      ],
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "slide",
            "layout",
            "master"
          ]
        },
        "part": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "slide_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "origin",
        "part",
        "key",
        "hidden"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "emu": {
          "type": "number"
        },
        "exact_emu": {
          "type": "string"
        },
        "mm": {
          "type": "number"
        },
        "pt": {
          "type": "number"
        }
      },
      "required": [
        "emu",
        "exact_emu",
        "mm",
        "pt"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "rule": {
          "enum": [
            "off-slide",
            "invalid-ooxml",
            "unreadable-part",
            "edge-margin",
            "overlap",
            "too-close",
            "misaligned",
            "uneven-gap",
            "uneven-size",
            "zero-size",
            "tiny-shape",
            "hidden-shape",
            "connector-unattached",
            "position-drift",
            "layout-override",
            "autofit-shrunk",
            "font-too-small",
            "font-size-inconsistent",
            "line-spacing-inconsistent",
            "font-family-count",
            "east-asian-font-unset",
            "empty-paragraph-spacing",
            "manual-line-break",
            "bullet-inconsistent",
            "title-missing",
            "title-duplicate",
            "empty-placeholder",
            "text-hygiene",
            "table-column-uneven",
            "text-overflow",
            "unbreakable-word",
            "excessive-wrap",
            "orphan-line",
            "font-missing",
            "table-cell-overflow",
            "table-overflow",
            "low-contrast",
            "low-contrast-non-text",
            "off-theme-color",
            "near-duplicate-color",
            "color-count",
            "image-distorted",
            "image-low-resolution",
            "image-crop-outside"
          ]
        },
        "slide": {
          "anyOf": [
            {
              "$ref": "#/$defs/slide"
            },
            {
              "type": "null"
            }
          ]
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "measured": {
          "anyOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/metric"
            }
          ]
        },
        "threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/metric"
            }
          ]
        },
        "confidence": {
          "enum": [
            "certain",
            "worst-case"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "suppressed": {
          "type": "boolean"
        },
        "locator": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "rule",
        "slide",
        "shapes",
        "measured",
        "threshold",
        "confidence",
        "evidence",
        "fingerprint",
        "suppressed",
        "locator",
        "details"
      ],
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "properties": {
        "rule": {
          "enum": [
            "off-slide",
            "invalid-ooxml",
            "unreadable-part",
            "edge-margin",
            "overlap",
            "too-close",
            "misaligned",
            "uneven-gap",
            "uneven-size",
            "zero-size",
            "tiny-shape",
