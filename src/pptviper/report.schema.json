        "locator": {
          "type": "string"
        },
        "properties": {
          "type": "object"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "bounds": {
          "type": "object",
          "properties": {
            "left": {
              "type": "object",
              "properties": {
                "low": {
                  "$ref": "#/$defs/measurement"
                },
                "high": {
                  "$ref": "#/$defs/measurement"
                }
              },
              "required": [
                "low",
                "high"
              ],
              "additionalProperties": false
            },
            "top": {
              "type": "object",
              "properties": {
                "low": {
                  "$ref": "#/$defs/measurement"
                },
                "high": {
                  "$ref": "#/$defs/measurement"
                }
              },
              "required": [
                "low",
                "high"
              ],
              "additionalProperties": false
            },
            "right": {
              "type": "object",
              "properties": {
                "low": {
                  "$ref": "#/$defs/measurement"
                },
                "high": {
                  "$ref": "#/$defs/measurement"
                }
              },
              "required": [
                "low",
                "high"
              ],
              "additionalProperties": false
            },
            "bottom": {
              "type": "object",
              "properties": {
                "low": {
                  "$ref": "#/$defs/measurement"
                },
                "high": {
                  "$ref": "#/$defs/measurement"
                }
              },
              "required": [
                "low",
                "high"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "left",
            "top",
            "right",
            "bottom"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "slide",
        "shapes",
        "locator",
        "properties",
        "branch"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "exact_value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "exact_value": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    }
